<!DOCTYPE html>

<html lang="en">
<head>
    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - OnlineStore</title>

    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />
</head>

<body>

    <!-- =========================================
         HEADER / NAVBAR
    ========================================== -->
    <header class="store-header">

        <div class="container">

            <div class="store-navbar">

                <!-- Brand -->
                <a asp-controller="Catalog"
                   asp-action="Index"
                   class="store-brand">

                    <span class="store-brand-icon">
                        OS
                    </span>

                    <span class="store-brand-text">
                        <strong>OnlineStore</strong>
                        <small>Modern Commerce</small>
                    </span>

                </a>


                <!-- Navigation -->
                <nav class="store-nav">

                    <a asp-controller="Catalog"
                       asp-action="Index">
                        Shop
                    </a>


                    @if (Context.User.Identity?.IsAuthenticated == true)
                    {
                        <a asp-controller="Order"
                           asp-action="Index">
                            My Orders
                        </a>
                    }


                    <a asp-controller="Basket"
                       asp-action="Index"
                       class="store-cart-link">
                        Basket
                    </a>


                    @if (Context.User.Identity?.IsAuthenticated == true)
                    {
                        <form asp-controller="Account"
                              asp-action="SignOut"
                              method="post">

                            <button type="submit"
                                    class="store-login-button">
                                Logout
                            </button>

                        </form>
                    }
                    else
                    {
                        <a asp-controller="Account"
                           asp-action="SignIn"
                           class="store-login-button">
                            Login
                        </a>
                    }

                </nav>

            </div>

        </div>

    </header>


    <!-- =========================================
         CURRENT PAGE CONTENT
    ========================================== -->
    <main role="main">

        @RenderBody()

    </main>


    <!-- =========================================
         FOOTER
    ========================================== -->
    <footer class="store-footer">

        <div class="container">

            <div class="store-footer-content">

                <div class="store-footer-brand">

                    <span class="store-brand-icon">
                        OS
                    </span>

                    <div>
                        <strong>OnlineStore</strong>
                        <p>Modern Commerce</p>
                    </div>

                </div>


                <p class="store-footer-copy">
                    © @DateTime.Now.Year OnlineStore.
                    All Rights Reserved.
                </p>

            </div>

        </div>

    </footer>


    <!-- =========================================
         JAVASCRIPT
    ========================================== -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <script src="~/js/site.js"
            asp-append-version="true"></script>


    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>