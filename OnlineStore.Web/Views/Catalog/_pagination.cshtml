@using OnlineStore.Web.ViewModels

@model CatalogIndex

@{
    var pagination = Model.PaginationInfo;
}


<div class="store-pagination">


    <!-- Previous -->

    <a class="store-page-button @pagination.Previous"
       asp-controller="Catalog"
       asp-action="Index"
       asp-route-page="@(pagination.ActualPage - 1)"
       asp-route-BrandFilterApplied="@Model.BrandFilterApplied"
       asp-route-TypeFilterApplied="@Model.TypesFilterApplied">

        ←

        Previous

    </a>


    <!-- Page indicator -->

    <div class="store-page-info">

        <span>
            @(pagination.ActualPage + 1)
        </span>

        of

        @pagination.TotalPages

    </div>


    <!-- Next -->

    <a class="store-page-button @pagination.Next"
       asp-controller="Catalog"
       asp-action="Index"
       asp-route-page="@(pagination.ActualPage + 1)"
       asp-route-BrandFilterApplied="@Model.BrandFilterApplied"
       asp-route-TypeFilterApplied="@Model.TypesFilterApplied">

        Next

        →

    </a>


</div>