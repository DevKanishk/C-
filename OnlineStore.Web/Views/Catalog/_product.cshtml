@using OnlineStore.ApplicationCore.Entities

@model CatalogItem


<form asp-controller="Basket"
      asp-action="AddToBasket"
      method="post"
      class="store-product-card">


    <!-- Product image -->

    <div class="store-product-image-wrapper">

        <img src="@Model.PictureUri"
             alt="@Model.Name"
             class="store-product-image" />


        <span class="store-product-badge">
            In Stock
        </span>

    </div>


    <!-- Product information -->

    <div class="store-product-content">


        <div class="store-product-category">

            PRODUCT

        </div>


        <h3 class="store-product-name">

            @Model.Name

        </h3>


        @if (!string.IsNullOrWhiteSpace(Model.Description))
        {

            <p class="store-product-description">

                @Model.Description

            </p>

        }


        <div class="store-product-footer">


            <div class="store-product-price">

                <span class="store-price-currency">
                    $
                </span>

                @Model.Price.ToString("N2")

            </div>


            <button type="submit"
                    class="store-add-button">

                <span>
                    +
                </span>

                Add to Basket

            </button>


        </div>

    </div>


    <!-- Existing values required by BasketController -->

    <input type="hidden"
           asp-for="@Model.CatalogBrand"
           name="brand" />

    <input type="hidden"
           asp-for="@Model.CatalogBrandId"
           name="brandId" />

    <input type="hidden"
           asp-for="@Model.CatalogType"
           name="type" />

    <input type="hidden"
           asp-for="@Model.CatalogTypeId"
           name="typeId" />

    <input type="hidden"
           asp-for="@Model.Description"
           name="description" />

    <input type="hidden"
           asp-for="@Model.Id"
           name="id" />

    <input type="hidden"
           asp-for="@Model.Name"
           name="name" />

    <input type="hidden"
           asp-for="@Model.PictureUri"
           name="pictureUri" />

    <input type="hidden"
           asp-for="@Model.Price"
           name="price" />

</form>